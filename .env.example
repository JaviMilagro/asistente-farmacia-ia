# Copia este fichero a .env y rellénalo. El fichero .env NO se sube al repositorio.
# Solo ANTHROPIC_API_KEY y DEMO_PASSWORD están activas; el resto son opcionales (descomenta para cambiarlas).
# Una variable vacía o solo con espacios equivale a no definirla.

# Clave de la API de Anthropic (obligatoria para ejecutar el asistente)
ANTHROPIC_API_KEY=

# Contraseña de acceso a la demo web (si se deja vacía, el acceso es libre; arrancar_demo.sh la exige)
DEMO_PASSWORD=

# Número de WhatsApp en formato internacional sin '+'. Si no se define, el botón de WhatsApp no se muestra
# WHATSAPP_NUMERO=

# Nombres configurables (por defecto: Lía / Farmacia Ejemplo / Marca Ejemplo)
# ASISTENTE_NOMBRE=
# FARMACIA_NOMBRE=
# MARCA_PROPIA=

# Base de las URLs de producto y ruta del catálogo (por defecto: https://ejemplo.invalid y datos/catalogo_ejemplo.json)
# URL_TIENDA_BASE=
# CATALOGO_RUTA=

# Mensajes máximos por sesión de la demo web (por defecto 30)
# LIMITE_MENSAJES=
